{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* 后端每个 Pydantic 模型都是 extra="forbid"（宁可响亮地失败）。
       前端对齐这个取向：类型必须严，不能让 undefined 静默流过去。 */
    "strict": true,

    /* 路径别名 —— 必须与 vite.config.ts 的 resolve.alias 两处一致。
       不写 baseUrl：TS 6 已弃用它，而 paths 从 4.4 起可独立使用（相对本文件解析）。 */
    "paths": { "@/*": ["./src/*"] },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
