# ============================================================
# 课径 CoursePath — 环境变量模板
# 使用方法：复制本文件为 .env，按需填写
#
# ⚠️ .env 已被 .gitignore 排除，请勿提交真实密钥。
# ============================================================

# -------- 大模型 API（可选）--------
# 全部留空时，应用自动运行在 mock 模式，使用内置样例数据，
# 所有核心功能（学分校验 / 冲突检测 / 路径规划 / 可视化）均可完整演示。
# 评审无需填写任何 Key 即可运行本项目。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# -------- 应用配置 --------
APP_PORT=8000
DATABASE_URL=sqlite:///./coursepath.db
